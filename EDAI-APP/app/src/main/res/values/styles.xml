<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="Theme.AUTOHUB" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/black</item> <!-- Change to your desired color -->
        <item name="colorPrimaryVariant">@color/white</item> <!-- Change to your desired color -->
        <item name="colorOnPrimary">@color/white</item> <!-- Change to your desired color -->
        <item name="colorSecondary">@color/black</item> <!-- Change to your desired color -->
        <item name="colorOnSecondary">@color/white</item> <!-- Change to your desired color -->
        <item name="android:windowBackground">@color/white</item> <!-- Change to your desired color -->
    </style>


    <style name="StatText">
        <item name="android:layout_width">match_parent</item>  <!-- or wrap_content -->
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">#000000</item>
    </style>



</resources>
