<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DAF4FF"
    tools:context=".MainActivity">

    <!-- Header Title -->
    <TextView
        android:id="@+id/textView27"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:backgroundTint="#D91D1D"
        android:gravity="center"
        android:text="@string/autohub"
        android:textColor="@color/black"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Profile Icon -->
    <ImageView
        android:id="@+id/imageView10"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:background="@drawable/rounded_bg_white"
        android:contentDescription="@string/profile_photo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_launcher_foreground" />

    <!-- Scrollable Grid -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/textView27"
        app:layout_constraintBottom_toTopOf="@+id/moreUtilitiesToAddText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            app:alignmentMode="alignMargins"
            app:columnCount="2"
            app:rowCount="3">

            <!-- Button 1: Expense Manager -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1">

                <ImageButton
                    android:id="@+id/expenseManager"
                    android:layout_width="147dp"
                    android:layout_height="161dp"
                    android:backgroundTint="@android:color/transparent"
                    android:contentDescription="@string/expensemanagerbutton"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/car_expense" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/expense"
                    android:textSize="20sp"
                    android:textColor="#000"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Button 2: Washing Center -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1">

                <ImageButton
                    android:id="@+id/washingCenter"
                    android:layout_width="147dp"
                    android:layout_height="161dp"
                    android:backgroundTint="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/go_to_washing"
                    app:srcCompat="@drawable/car_wash" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/washing"
                    android:textSize="20sp"
                    android:textColor="#000"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Button 3: Mechanic -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1">

                <ImageButton
                    android:id="@+id/mechanic"
                    android:layout_width="147dp"
                    android:layout_height="161dp"
                    android:backgroundTint="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/mechanic"
                    app:srcCompat="@drawable/mechanic_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mechanic"
                    android:textSize="20sp"
                    android:textColor="#000"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Button 4: OBD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1">

                <ImageButton
                    android:id="@+id/obd"
                    android:layout_width="147dp"
                    android:layout_height="161dp"
                    android:backgroundTint="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/obd_reader"
                    app:srcCompat="@drawable/obd" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obd_reader"
                    android:textSize="20sp"
                    android:textColor="#000"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Button 5: GeoFence Status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1">

                <ImageButton
                    android:id="@+id/geoFenceStatus"
                    android:layout_width="147dp"
                    android:layout_height="161dp"
                    android:backgroundTint="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/geofence_status"
                    app:srcCompat="@drawable/geofence" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/geofence_status"
                    android:textSize="20sp"
                    android:textColor="#000"
                    android:gravity="center" />
            </LinearLayout>

        </androidx.gridlayout.widget.GridLayout>
    </ScrollView>

    <!-- Coming Soon Text -->
    <TextView
        android:id="@+id/moreUtilitiesToAddText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="More utilities coming soon..."
        android:textSize="18sp"
        android:textStyle="italic"
        android:textColor="#555"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
