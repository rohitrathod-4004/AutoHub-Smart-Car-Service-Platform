<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#BCA3E8"
    android:backgroundTint="#BCA3E8">

    <TextView
        android:id="@+id/updateDetails"
        android:layout_width="390dp"
        android:layout_height="90dp"
        android:layout_marginBottom="108dp"
        android:background="#9765EF"
        android:drawableEnd="@drawable/baseline_arrow_forward_ios_24"
        android:gravity="center|start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Update Details"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.476"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/adjustTimeSlots"
        app:layout_constraintVertical_bias="0.696" />

    <TextView
        android:id="@+id/adjustTimeSlots"
        android:layout_width="390dp"
        android:layout_height="90dp"
        android:layout_marginTop="4dp"
        android:background="#9765EF"
        android:drawableEnd="@drawable/baseline_arrow_forward_ios_24"
        android:gravity="center|start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Update Time Slot"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.476"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView52"
        app:layout_constraintVertical_bias="0.136" />

    <TextView
        android:id="@+id/textView51"
        android:layout_width="390dp"
        android:layout_height="90dp"
        android:layout_marginTop="44dp"
        android:background="#9765EF"
        android:drawableEnd="@drawable/baseline_arrow_forward_ios_24"
        android:gravity="center|start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="View Request"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.476"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView57"

        />

    <TextView
        android:id="@+id/textView52"
        android:layout_width="390dp"
        android:layout_height="90dp"
        android:layout_marginTop="36dp"
        android:background="#9765EF"
        android:drawableEnd="@drawable/baseline_arrow_forward_ios_24"
        android:gravity="center|start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="View Appointment History"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.476"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView51" />

    <TextView
        android:id="@+id/textView57"
        android:layout_width="415dp"
        android:layout_height="83dp"
        android:background="#A67DED"
        android:backgroundTint="#A67DED"
        android:gravity="center"
        android:paddingStart="30dp"
        android:paddingEnd="12dp"
        android:text="AutoHub"
        android:textColor="#090909"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/imageView11"
        android:layout_width="55dp"
        android:layout_height="41dp"
        android:background="#A67DED"
        android:visibility="gone"
        android:contentDescription="GoToBack"
        app:layout_constraintBottom_toBottomOf="@+id/textView57"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.04"
        app:layout_constraintStart_toStartOf="@+id/textView57"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.38"
        app:srcCompat="@drawable/baseline_arrow_back_ios_24" />

    <ImageView
        android:id="@+id/imageView13"
        android:layout_width="63dp"
        android:layout_height="51dp"
        android:background="#A67DED"
        android:visibility="gone"
        android:contentDescription="Profile"
        app:layout_constraintBottom_toBottomOf="@+id/textView57"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/textView57"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_launcher_foreground" />
</androidx.constraintlayout.widget.ConstraintLayout>