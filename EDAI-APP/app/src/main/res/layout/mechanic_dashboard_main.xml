<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B9E1FF"
    android:padding="24dp"
    tools:context=".mechanic.MechanicActivity">

    <!-- App Logo -->

    <!-- App Name -->

    <!-- Availability Button -->

    <ImageView
        android:id="@+id/appLogo"
        android:layout_width="170dp"
        android:layout_height="115dp"
        android:layout_marginTop="20dp"
        android:contentDescription="App Logo"
        android:src="@drawable/car"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mechanic Assistance"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appLogo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/be_active"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Availability"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0288D1"
        app:cornerRadius="16dp"
        app:iconPadding="8dp"
        style="@style/Widget.MaterialComponents.Button"
        app:layout_constraintTop_toBottomOf="@id/appName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- History Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/seeHistory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="History"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0288D1"
        app:cornerRadius="16dp"
        app:iconPadding="8dp"
        style="@style/Widget.MaterialComponents.Button"
        app:layout_constraintTop_toBottomOf="@id/be_active"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Emergency Requests Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/emergencyRequests"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Emergency Requests"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0288D1"
        app:cornerRadius="16dp"
        app:iconPadding="8dp"
        style="@style/Widget.MaterialComponents.Button"
        app:layout_constraintTop_toBottomOf="@id/seeHistory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Footer -->
    <TextView
        android:id="@+id/footerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Powered by Autohub"
        android:textSize="12sp"
        android:textColor="#555555"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
